SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_NAME=ltc_db
DB_USER=ltc_user
DB_PASSWORD=ltc_password
DB_HOST=localhost
DB_PORT=5432

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:5173

# JWT
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# 地理位置管理
# TGOS 全國門牌地址定位服務（內政部，免費申請）。留空時改用示範用假座標。
TGOS_APP_ID=
TGOS_APP_KEY=
# 超過排定開始時間幾分鐘仍未打卡即判定為遲到
SERVICE_LATE_GRACE_MINUTES=15
# 居服員定位超過幾分鐘未更新即視為離線
CAREGIVER_LOCATION_STALE_MINUTES=30
